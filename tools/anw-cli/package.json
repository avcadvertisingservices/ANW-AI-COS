{
  "name": "@anw/anw-cli",
  "version": "0.2.0",
  "private": true,
  "description": "Developer CLI for the ANW AI Content Operating System.",
  "type": "module",
  "bin": {
    "anw": "./dist/cli.js"
  },
 "scripts": {
  "build": "tsc",
  "dev": "tsx src/cli.ts",
  "typecheck": "tsc --noEmit",
  "test": "npm run build && node --test dist/tests/generators.test.js dist/tests/repair.test.js",
  "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
},
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
